# Google Gemini API Keys (5 contas)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# LiteLLM Configuration
LITELLM_MASTER_KEY=sk-prod-
LITELLM_LOG_LEVEL=INFO
LITELLM_NUM_WORKERS=8
LITELLM_REQUEST_TIMEOUT=60
LITELLM_NUM_RETRIES=3

# Databases
POSTGRES_USER=litellm
POSTGRES_PASSWORD=
POSTGRES_DB=litellm
POSTGRES_PORT=5432

REDIS_PASSWORD=

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Google Cloud Project ID (auto key generation)
GOOGLE_CLOUD_PROJECT=

# Rotation script (optional)
MONITOR_INTERVAL=300
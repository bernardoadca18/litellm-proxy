# ============================================================
# API KEYS - Add as many as you have
# ============================================================

# Google Gemini API Keys (1-30+ keys supported)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
GEMINI_API_KEY_11=

# OpenRouter API Keys (1-30+ keys supported)
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=
OPENROUTER_API_KEY_7=
OPENROUTER_API_KEY_8=
OPENROUTER_API_KEY_9=
OPENROUTER_API_KEY_10=
OPENROUTER_API_KEY_11=

# Groq API Keys (1-10+ keys supported)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# ============================================================
# LITELLM PROXY SETTINGS
# ============================================================

# Master key for API authentication (required)
LITELLM_MASTER_KEY=

# Log level: ERROR, WARNING, INFO, DEBUG
# WARNING recommended for production (low noise)
# INFO for troubleshooting
LITELLM_LOG_LEVEL=WARNING

# Number of workers (1 recommended for RAM efficiency)
# Use 2+ only if benchmarks show necessity with multiple concurrent requests
LITELLM_NUM_WORKERS=1

# Request timeout in seconds
LITELLM_REQUEST_TIMEOUT=90

# ============================================================
# OPTIONAL: REDIS (for multi-worker or caching)
# ============================================================
# Only needed if using profiles: cache, multiworker
# REDIS_PASSWORD=

# ============================================================
# OPTIONAL: POSTGRESQL (for persistence, teams, budgets)
# ============================================================
# Only needed if using profile: database
# POSTGRES_USER=litellm
# POSTGRES_PASSWORD=
# POSTGRES_DB=litellm
# DATABASE_URL=postgresql://litellm:password@postgres:5432/litellm

# ============================================================
# OPTIONAL: GRAFANA (for monitoring)
# ============================================================
# Only needed if using profile: monitoring
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=

# ============================================================
# OPTIONAL: OLLAMA (local models)
# ============================================================
OLLAMA_API_BASE=http://host.docker.internal:11434

# ============================================================
# DEPRECATED / NOT RECOMMENDED
# ============================================================
# GOOGLE_CLOUD_PROJECT=  # Used by rotate-keys.sh for auto key creation
# MONITOR_INTERVAL=300   # Key rotation interval (not recommended)
